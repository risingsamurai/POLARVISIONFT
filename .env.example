# --- POLARIS local stack ---
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://polaris:polaris@postgres:5432/polaris

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ECMWF Copernicus CDS (ERA5). Leave empty to stay on cached fallback.
CDS_API_KEY=

# NASA Earthdata (NSIDC NetCDF). Leave empty to stay on cached fallback.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Mapbox GL JS. If unset, frontend uses MapLibre + free OSM raster tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public API base used by the Next.js browser bundle
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Ingestion cadence (hours)
INGEST_INTERVAL_HOURS=6
